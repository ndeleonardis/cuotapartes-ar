# Copiá este archivo como .env y completá los valores reales. El .env no se versiona.
# Sin URL_BASE ni CLAVES el servicio no arranca: no hay valores por defecto.

# Conexión a la base `mercado` con el rol api_lectura (solo lectura).
URL_BASE=postgresql://api_lectura:CAMBIAR@postgres:5432/mercado

# Una clave por consumidor, separadas por coma, con el formato nombre:clave.
# Generá cada clave con: python -c "import secrets; print(secrets.token_urlsafe(32))"
CLAVES=lemonhouse:CAMBIAR
